[Unit]
Description=Hearthgate home server gateway
Documentation=https://github.com/krotovic-com/hearthgate
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/hearthgate --config /etc/hearthgate/hearthgate.toml run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
WatchdogSec=30s
TimeoutStopSec=45s

# A dedicated, unprivileged user, created from hearthgate.sysusers.
User=hearthgate
Group=hearthgate
# To route to Docker containers, let Hearthgate read the Docker socket by
# uncommenting this line. Access to the Docker socket is equivalent to root,
# so only do this if you use docker services.
#SupplementaryGroups=docker

# Only the capabilities Hearthgate needs: bind ports below 1024, and load
# its nftables firewall (the nft program it runs inherits these).
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true

# Filesystem: read-only system, private /tmp, state in /var/lib/hearthgate.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
StateDirectory=hearthgate
StateDirectoryMode=0700
ConfigurationDirectory=hearthgate
LogsDirectory=hearthgate
UMask=0077

# Kernel and process hardening.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @debug @obsolete @cpu-emulation
SystemCallErrorNumber=EPERM

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
