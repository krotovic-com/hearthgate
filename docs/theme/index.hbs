<!DOCTYPE html>
<html lang="{{ language }}" dir="{{ text_direction }}">
<head>
    <!-- Hearthgate docs theme for mdBook. Matches the website at the site root (site/index.html). -->
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    {{#if base_url}}
    <base href="{{ base_url }}">
    {{/if}}
    {{> head}}
    <meta name="description" content="{{ description }}">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0E1A2B">
    {{#if favicon_svg}}
    <link rel="icon" href="{{ resource "favicon.svg" }}" type="image/svg+xml">
    {{/if}}
    {{#if favicon_png}}
    <link rel="icon" href="{{ resource "favicon.png" }}" sizes="32x32">
    {{/if}}
    <!-- The fonts are shared with the website one level up; the docs fall back to system fonts when served alone. -->
    <link rel="stylesheet" href="{{ path_to_root }}../assets/fonts.css">
    {{#each additional_css}}
    <link rel="stylesheet" href="{{ resource this }}">
    {{/each}}
    <script>
        const path_to_root = "{{ path_to_root }}";
        {{#if search_js}}
        window.path_to_searchindex_js = "{{ resource "searchindex.js" }}";
        {{/if}}
        try {
            const t = localStorage.getItem("hearthgate-theme");
            if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
        } catch (e) {}
    </script>
    <script src="{{ resource "toc.js" }}"></script>
</head>
<body>
    <a class="skip" href="#content">Skip to the content</a>

    <header class="bar">
        <div class="bar-in gutter">
            <a class="brand" href="{{ path_to_root }}../" aria-label="Hearthgate home">
                <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M39.98 29.81A17 17 0 1 1 39.98 18.19" stroke="#F6F8FB" stroke-width="4" stroke-linecap="round" fill="none"/><path d="M46 24H29" stroke="#3B6EF5" stroke-width="4" stroke-linecap="round" fill="none"/><circle cx="24" cy="24" r="5" fill="#3B6EF5"/><circle cx="17" cy="15.5" r="2.5" fill="#2BC6A0"/><circle cx="17" cy="32.5" r="2.5" fill="#2BC6A0"/></svg>
                <span>hearthgate</span>
            </a>
            <a class="docs-tag" href="{{ path_to_root }}index.html">docs</a>
            {{#if search_enabled}}
            <button id="search-toggle" class="search" type="button" aria-expanded="false" aria-controls="search-wrapper" aria-keyshortcuts="/ s">
                <svg viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4"/></g></svg>
                <span>Search the docs</span>
                <kbd>/</kbd>
            </button>
            {{/if}}
            <nav class="bar-links" aria-label="Site">
                <a class="hide-md" href="{{ path_to_root }}../#features">Features</a>
                <a class="hide-sm" href="{{ path_to_root }}index.html" aria-current="page">Docs</a>
                <a class="hide-md" href="https://github.com/krotovic-com/hearthgate">GitHub</a>
                <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch between light and dark">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/></g></svg>
                </button>
                <a class="btn-dl hide-sm" href="{{ path_to_root }}../#install">Download</a>
                <button class="menu-btn" id="menu-toggle" type="button" aria-expanded="false" aria-controls="sidebar">Menu</button>
            </nav>
        </div>
        {{#if search_enabled}}
        <div id="search-wrapper" class="search-panel hidden">
            <div class="gutter search-in">
                <form id="searchbar-outer" class="searchbar-outer" role="search">
                    <input type="search" id="searchbar" name="searchbar" placeholder="Search the docs" aria-controls="searchresults-outer" aria-describedby="searchresults-header">
                </form>
                <div id="searchresults-outer" class="searchresults-outer hidden">
                    <div id="searchresults-header" class="searchresults-header"></div>
                    <ul id="searchresults"></ul>
                </div>
            </div>
        </div>
        {{/if}}
    </header>

    <div class="layout gutter">
        <nav id="sidebar" class="side" aria-label="Documentation">
            <mdbook-sidebar-scrollbox class="sidebar-scrollbox"></mdbook-sidebar-scrollbox>
            <noscript>
                <iframe class="sidebar-iframe-outer" src="{{ path_to_root }}toc.html" title="Table of contents"></iframe>
            </noscript>
        </nav>

        <div id="content" class="content">
            <main>
                {{{ content }}}
            </main>

            <div class="edit">
                {{#if git_repository_edit_url}}
                <a href="{{ git_repository_edit_url }}">Edit this page on GitHub</a>
                {{/if}}
                <span>Hearthgate 1.0</span>
            </div>
            <nav class="pager" aria-label="Previous and next page">
                {{#previous}}
                <a class="prev" rel="prev" href="{{ path_to_root }}{{ link }}" aria-keyshortcuts="Left"><small>Previous</small><b data-title-for="{{ link }}">Previous page</b></a>
                {{/previous}}
                {{#next}}
                <a class="next" rel="next prefetch" href="{{ path_to_root }}{{ link }}" aria-keyshortcuts="Right"><small>Next</small><b data-title-for="{{ link }}">Next page</b></a>
                {{/next}}
            </nav>
        </div>

        <aside class="toc" id="page-toc" aria-label="On this page" hidden>
            <h4>On this page</h4>
            <ul></ul>
            <div class="help">
                {{#if git_repository_edit_url}}
                <a href="{{ git_repository_edit_url }}">Edit this page</a>
                {{/if}}
                <a href="https://github.com/krotovic-com/hearthgate/issues">Ask a question</a>
            </div>
        </aside>
    </div>

    {{#if live_reload_endpoint}}
    <script>
        const socket = new WebSocket((location.protocol === "https:" ? "wss:" : "ws:") + "//" + location.host + "/" + "{{{live_reload_endpoint}}}");
        socket.onmessage = function (event) { if (event.data === "reload") { socket.close(); location.reload(); } };
        window.onbeforeunload = function () { socket.close(); };
    </script>
    {{/if}}

    {{#if search_js}}
    <script src="{{ resource "elasticlunr.min.js" }}"></script>
    <script src="{{ resource "mark.min.js" }}"></script>
    <script src="{{ resource "searcher.js" }}"></script>
    {{/if}}
    <script src="{{ resource "highlight.js" }}"></script>
    {{#each additional_js}}
    <script src="{{ resource this }}"></script>
    {{/each}}

    {{#if fragment_map}}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const fragmentMap = {{{fragment_map}}};
            const target = fragmentMap[window.location.hash];
            if (target) window.location.replace(new URL(target, window.location.href).href);
        });
    </script>
    {{/if}}
</body>
</html>
